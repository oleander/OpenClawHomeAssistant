+#!/command/with-contenv bash
+# shellcheck shell=bash
+# ==============================================================================
+# OpenClaw Assistant - Initialization Script
+# Runs once before services start (s6-overlay oneshot)
+# ==============================================================================
+set -euo pipefail
+
+# Constants
+readonly OPENCLAW_CONFIG="/config/.openclaw/openclaw.json"
+readonly SESSIONS_DIR_BASE="/tmp/openclaw-sessions"
+readonly OPTIONS_FILE="/data/options.json"
+readonly READOPT="/usr/local/bin/readopt"
+
+# Ensure Homebrew is in PATH for openclaw CLI
+export PATH="/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:${PATH}"
+export HOME=/config
+export OPTIONS_FILE
+export OPENCLAW_CONFIG_PATH="${OPENCLAW_CONFIG}"
+
+# ==============================================================================
+# Logging helper (works without bashio)
+# ==============================================================================
+log_info() {
+    echo "[$(date '+%H:%M:%S')] INFO: $*"
+}
+
+log_error() {
+    echo "[$(date '+%H:%M:%S')] ERROR: $*" >&2
+}
+
+log_info "Starting OpenClaw Assistant initialization..."
+
+# ==============================================================================
+# Read configuration options
+# ==============================================================================
+TZ=$("${READOPT}" '.timezone' '"UTC"')
+HA_TOKEN=$("${READOPT}" '.homeassistant_token' '""')
+GATEWAY_BIND=$("${READOPT}" '.gateway_bind_mode' '"loopback"')
+GATEWAY_PORT=$("${READOPT}" '.gateway_port' '18789')
+ALLOW_INSECURE=$("${READOPT}" '.allow_insecure_auth' 'false')
+
+export TZ
+
+# ==============================================================================
+# Setup directories
+# ==============================================================================
+log_info "Setting up directories..."
+mkdir -p /config/.openclaw/agents/main
+mkdir -p /config/clawd
+mkdir -p /config/keys
+mkdir -p /config/secrets
+mkdir -p /run/nginx
+mkdir -p /etc/nginx/html
+
+# Back-compat: some docs/scripts assume /data exists
+if [[ ! -e /data ]]; then
+    ln -s /config /data 2>/dev/null || true
+fi
+
+# ==============================================================================
+# Use tmp-backed session storage (no persistence across restarts)
+# Configure via openclaw.json instead of filesystem links
+# ==============================================================================
+SESSIONS_DIR="$(mktemp -d "${SESSIONS_DIR_BASE}.XXXXXX")"
+readonly SESSIONS_DIR
+SESSION_STORE_PATH="${SESSIONS_DIR}/sessions.json"
+openclaw config set session.store "${SESSION_STORE_PATH}"
+
+# ==============================================================================
+# Save Home Assistant token (if provided)
+# ==============================================================================
+if [[ -n "${HA_TOKEN}" && "${HA_TOKEN}" != "null" ]]; then
+    log_info "Saving Home Assistant token..."
+    umask 077
+    echo -n "${HA_TOKEN}" > /config/secrets/homeassistant.token
+    umask 022
+fi
+
+# ==============================================================================
+# Bootstrap OpenClaw config if missing
+# ==============================================================================
+CURRENT_TOKEN="$(timeout 2s openclaw config get gateway.auth.token 2>/dev/null | tr -d '\n' || true)"
+if [[ -z "${CURRENT_TOKEN}" || "${CURRENT_TOKEN}" == "null" ]]; then
+    log_info "Bootstrapping OpenClaw config (missing token)..."
+    GW_BOOTSTRAP_TOKEN="$(python3 - << 'PYTHON'
+import secrets
+print(secrets.token_urlsafe(24))
+PYTHON
+)"
+
+    openclaw config set gateway.mode local
+    openclaw config set gateway.port 18789
+    openclaw config set gateway.bind loopback
+    openclaw config set gateway.auth.mode token
+    openclaw config set gateway.auth.token "${GW_BOOTSTRAP_TOKEN}"
+    openclaw config set hooks.enabled false
+fi
+
+# ==============================================================================
+# Apply gateway settings from add-on options
+# ==============================================================================
+log_info "Applying gateway settings (bind=${GATEWAY_BIND}, port=${GATEWAY_PORT})..."
+python3 /oc_config_helper.py apply-gateway-settings "${GATEWAY_BIND}" "${GATEWAY_PORT}" "${ALLOW_INSECURE}"
+
+# ==============================================================================
+# Render nginx config templates
+# ==============================================================================
+log_info "Rendering nginx configuration..."
+
+# Copy nginx.conf template (it's static, no substitutions needed)
+cp /etc/nginx/nginx.conf.tpl /etc/nginx/nginx.conf
+
+log_info "Initialization complete!"
diff --git a/openclaw_assistant/rootfs/usr/local/bin/readopt b/openclaw_assistant/rootfs/usr/local/bin/readopt
new file mode 100644
index 0000000..25d8731
--- /dev/null
+++ b/openclaw_assistant/rootfs/usr/local/bin/readopt
@@ -0,0 +1,23 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+OPTIONS_FILE="${OPTIONS_FILE:-/data/options.json}"
+
+if [[ $# -lt 1 || $# -gt 2 ]]; then
+    echo "Usage: readopt <jq_key> [default]" >&2
+    exit 2
+fi
+
+key="$1"
+default="${2:-""}"
+
+if [[ -f "${OPTIONS_FILE}" ]]; then
+    value=$(jq -r "${key} // ${default}" "${OPTIONS_FILE}" 2>/dev/null || true)
+    if [[ -n "${value}" && "${value}" != "null" ]]; then
+        echo "${value}"
+        exit 0
+    fi
+fi
+
+# Return default without quotes (matches existing behavior)
+echo "${default//\"/}"
