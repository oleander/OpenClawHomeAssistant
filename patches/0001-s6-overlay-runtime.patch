+export PATH="/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:${PATH}"
+export HOME=/config
+
+# Run ttyd
+# -W: Writable mode (allow input)
+# -i: Bind to localhost only (nginx proxies to it)
+# -p: Port
+# -b: Base path for URLs
+exec ttyd -W -i 127.0.0.1 -p 7681 -b /terminal bash
