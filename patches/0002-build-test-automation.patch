diff --git a/smoke_test.sh b/smoke_test.sh
new file mode 100755
index 0000000..a0a12b1
--- /dev/null
+++ b/smoke_test.sh
@@ -0,0 +1,317 @@
+#!/bin/bash
+# OpenClaw Assistant - Complete Test Suite
+# Run this in your project root directory
+
+set -euo pipefail
+
+# Colors
+RED='\033[0;31m'
+GREEN='\033[0;32m'
+YELLOW='\033[1;33m'
+BLUE='\033[0;34m'
+NC='\033[0m'
+
+# Counters
+PASSED=0
+FAILED=0
+SKIPPED=0
+CONTAINER="openclaw-test-$(date +%s)"
+IMAGE="openclaw-test:latest"
+
+# Logging functions
+# Pre-increment (++VAR) returns new value, avoiding set -e exit when VAR starts at 0
+log_ok() { echo -e "${GREEN}[✓]${NC} $*"; ((++PASSED)); }
+log_fail() { echo -e "${RED}[✗]${NC} $*"; ((++FAILED)); }
+log_warn() { echo -e "${YELLOW}[!]${NC} $*"; ((++SKIPPED)); }
+log_test() { echo -e "${BLUE}→${NC} $*"; }
+log_section() { echo ""; echo -e "${BLUE}════════════════════════════════════════════${NC}"; echo -e "${BLUE}$1${NC}"; }
+
+# Cleanup on exit
+cleanup() {
+    echo "Cleaning up..."
+    docker stop "$CONTAINER" 2>/dev/null || true
+    docker rm "$CONTAINER" 2>/dev/null || true
+    rm -rf ./test_data ./test_config 2>/dev/null || true
+}
+trap cleanup EXIT
+
+# Wait for condition
+wait_ready() {
+    local cmd="$1"
+    for i in {1..30}; do
+        if eval "$cmd" 2>/dev/null; then
+            return 0
+        fi
+        sleep 1
+    done
+    return 1
+}
+
+# ============================================================================
+# TESTS START
+# ============================================================================
+
+main() {
+    log_section "OPENCLAW ASSISTANT - COMPLETE TEST SUITE"
+
+    # ========== STAGE 1: Files ==========
+    log_section "STAGE 1: Files & Configuration"
+
+    log_test "Dockerfile exists"
+    if [ -f "./openclaw_assistant/Dockerfile" ]; then
+        log_ok "Found"
+    else
+        log_fail "Not found"
+        exit 1
+    fi
+
+    log_test "Required files"
+    for file in config.yaml entrypoint.sh nginx.conf.tpl oc_config_helper.py; do
+        if [ -f "./openclaw_assistant/$file" ]; then
+            log_ok "$file"
+        else
+            log_fail "$file missing"
+        fi
+    done
+
+    log_test "Optional documentation"
+    for file in README.md DOCS.md CHANGELOG.md apparmor.txt; do
+        if [ -f "./openclaw_assistant/$file" ]; then
+            log_ok "$file exists"
+        else
+            log_warn "$file missing (recommended)"
+        fi
+    done
+
+    log_test "nginx.conf.tpl has Ingress IP filter"
+    if grep -q "allow.*172.30.32.2" ./openclaw_assistant/nginx.conf.tpl; then
+        log_ok "IP filtering configured"
+    else
+        log_warn "No Ingress IP filter - add: allow 172.30.32.2; deny all;"
+    fi
+
+    # ========== STAGE 2: Build ==========
+    log_section "STAGE 2: Docker Build"
+
+    log_test "Building Docker image"
+    if docker build -t "$IMAGE" ./openclaw_assistant > /tmp/build.log 2>&1; then
+        log_ok "Build successful"
+    else
+        log_fail "Build failed"
+        echo "Last 10 lines of build log:"
+        tail -10 /tmp/build.log | sed 's/^/  /'
+        exit 1
+    fi
+
+    log_test "Image created"
+    if docker image inspect "$IMAGE" > /dev/null 2>&1; then
+        local size=$(docker image inspect "$IMAGE" --format='{{.Size}}' | numfmt --to=iec 2>/dev/null || echo "unknown")
+        log_ok "Size: $size"
+    else
+        log_fail "Image not found"
+        exit 1
+    fi
+
+    # ========== STAGE 3: Container Start ==========
+    log_section "STAGE 3: Container Startup"
+
+    log_test "Creating test data"
+    mkdir -p ./test_data ./test_config
+    cat > ./test_data/options.json << 'EOF'
+{
+  "timezone": "UTC",
+  "enable_terminal": true,
+  "gateway_public_url": "http://localhost:18789",
+  "gateway_bind_mode": "lan",
+  "gateway_port": 18789,
+  "allow_insecure_auth": true
+}
+EOF
+    log_ok "options.json created"
+
+    log_test "Starting container"
+    if docker run -d \
+        --name "$CONTAINER" \
+        -v "$(pwd)/test_data:/data:rw" \
+        -v "$(pwd)/test_config:/config:rw" \
+        -p 18789:18789 \
+        -p 7681:7681 \
+        -p 8099:8099 \
+        "$IMAGE" > /tmp/container.id 2>&1; then
+        log_ok "Container started"
+    else
+        log_fail "Container failed to start"
+        exit 1
+    fi
+
+    log_test "Waiting for initialization"
+    if wait_ready "docker exec $CONTAINER test -f /config/.openclaw/openclaw.json"; then
+        log_ok "Container initialized"
+    else
+        log_fail "Initialization timeout (30s)"
+        docker logs "$CONTAINER" 2>&1 | tail -10 | sed 's/^/  /'
+        exit 1
+    fi
+
+    # ========== STAGE 4: Ports & Network ==========
+    log_section "STAGE 4: Port Access & Network"
+
+    log_test "Gateway port 18789"
+    if wait_ready "curl -sf http://localhost:18789/ > /dev/null"; then
+        log_ok "Responding"
+    else
+        log_fail "Not responding"
+    fi
+
+    log_test "Ingress port 8099"
+    if wait_ready "curl -sf http://localhost:8099/ > /dev/null"; then
+        log_ok "Responding"
+    else
+        log_fail "Not responding"
+    fi
+
+    log_test "Terminal at /terminal"
+    if curl -sf http://localhost:8099/terminal/ > /dev/null 2>&1; then
+        log_ok "Accessible"
+    else
+        log_fail "Not accessible"
+    fi
+
+    log_test "Port binding verification"
+    local ss_output=$(docker exec "$CONTAINER" ss -tlnp 2>/dev/null || echo "")
+    if echo "$ss_output" | grep -q "127.0.0.1:7681"; then
+        log_ok "ttyd on localhost:7681 (correct)"
+    else
+        log_warn "ttyd binding not found"
+    fi
+
+    # ========== STAGE 5: Configuration ==========
+    log_section "STAGE 5: Configuration & Settings"
+
+    log_test "openclaw.json created"
+    if docker exec "$CONTAINER" test -f /config/.openclaw/openclaw.json; then
+        log_ok "File exists"
+    else
+        log_fail "File not created"
+    fi
+
+    log_test "Config is valid JSON"
+    if docker exec "$CONTAINER" cat /config/.openclaw/openclaw.json | jq . > /dev/null 2>&1; then
+        log_ok "Valid JSON"
+    else
+        log_fail "Invalid or unreadable"
+    fi
+
+    log_test "Gateway token generated"
+    local token=$(docker exec "$CONTAINER" jq -r '.gateway.auth.token' /config/.openclaw/openclaw.json 2>/dev/null || echo "")
+    if [ -n "$token" ] && [ "$token" != "null" ]; then
+        log_ok "Token: ${token:0:16}..."
+    else
+        log_fail "No token generated"
+    fi
+
+    log_test "Token authentication works"
+    if [ -n "$token" ]; then
+        if curl -sf "http://localhost:18789/?token=$token" | grep -q "OpenClaw"; then
+            log_ok "Authentication successful"
+        else
+            log_fail "Token auth failed"
+        fi
+    fi
+
+    log_test "Settings applied from options.json"
+    if docker exec "$CONTAINER" jq -e '.gateway.bind == "lan"' /config/.openclaw/openclaw.json > /dev/null 2>&1; then
+        log_ok "bind=lan applied"
+    else
+        log_fail "Settings not applied"
+    fi
+
+    if docker exec "$CONTAINER" jq -e '.gateway.port == 18789' /config/.openclaw/openclaw.json > /dev/null 2>&1; then
+        log_ok "port=18789 applied"
+    else
+        log_fail "Port not applied"
+    fi
+
+    # ========== STAGE 6: Services ==========
+    log_section "STAGE 6: Services & Directories"
+
+    log_test "Session directory exists"
+    if docker exec "$CONTAINER" test -d /config/.openclaw/agents/main/sessions; then
+        log_ok "Created"
+    else
+        log_fail "Missing"
+    fi
+
+    log_test "Secrets directory exists"
+    if docker exec "$CONTAINER" test -d /config/secrets; then
+        log_ok "Created"
+    else
+        log_fail "Missing"
+    fi
+
+    log_test "Services running"
+    if docker exec "$CONTAINER" sh -c "ps aux | grep -i 'openclaw' | grep -v grep" > /dev/null 2>&1; then
+        log_ok "Gateway running"
+    else
+        log_warn "Gateway process not found"
+    fi
+
+    # ========== STAGE 7: Security & Logs ==========
+    log_section "STAGE 7: Security & Logs"
+
+    log_test "Ingress IP filtering (security)"
+    local http_code=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:8099/ 2>/dev/null || echo "000")
+    if [ "$http_code" = "403" ]; then
+        log_ok "Correctly rejects non-HA IPs (403)"
+    elif [ "$http_code" = "200" ]; then
+        log_warn "Accepts all IPs (HTTP 200) - should be 403"
+    else
+        log_warn "Unexpected response: $http_code"
+    fi
+
+    log_test "Logs for errors"
+    local error_count
+    error_count=$(docker logs "$CONTAINER" 2>&1 | grep -ci "\[error\]" || true)
+    if [ "${error_count:-0}" -eq 0 ]; then
+        log_ok "No error messages"
+    else
+        log_warn "Found $error_count error messages"
+        docker logs "$CONTAINER" 2>&1 | grep -i "\[error\]" | head -3 | sed 's/^/  /'
+    fi
+
+    # ========== STAGE 8: Cleanup ==========
+    log_section "STAGE 8: Cleanup"
+
+    log_test "Stopping container"
+    if docker stop "$CONTAINER" > /dev/null 2>&1; then
+        log_ok "Stopped cleanly"
+    else
+        log_fail "Stop failed"
+    fi
+
+    # ========== RESULTS ==========
+    log_section "TEST RESULTS"
+
+    echo ""
+    echo "  ${GREEN}✓ Passed:  $PASSED${NC}"
+    echo "  ${RED}✗ Failed:  $FAILED${NC}"
+    echo "  ${YELLOW}! Skipped: $SKIPPED${NC}"
+    echo ""
+
+    if [ $FAILED -eq 0 ]; then
+        echo -e "${GREEN}✓ All tests passed!${NC}"
+        echo ""
+        echo "Next steps:"
+        echo "  1. Add README.md, DOCS.md, CHANGELOG.md to openclaw_assistant/"
+        echo "  2. Verify nginx.conf.tpl has 'allow 172.30.32.2; deny all;'"
+        echo "  3. Optionally add apparmor.txt for +1 security point"
+        echo "  4. Push to Home Assistant add-on repository"
+        return 0
+    else
+        echo -e "${RED}✗ Some tests failed - review output above${NC}"
+        return 1
+    fi
+}
+
+main "$@"
+
